from os import path
configfile: "configfile.yaml"

include: "rules/prepare_ppi.smk"
include: "rules/module_detection.smk"
include: "rules/enrichment_analysis.smk"

rule all:
    input:
        [
            path.join(config["app_enrich_dir"],
            f"{network}/output/{algo}/{param}/{enrichment_type}/{enrichment_subtype}/results/done")
            for network in config['ppi_networks'] + config['coexpression_networks']
            for algo, params in config['module_detection_params'].items()
            for param in params
            for enrichment_type, enrichment_subtypes in config['enrichment_types'].items()
            for enrichment_subtype in enrichment_subtypes
        ],

rule only_ppi_networks:
    input:
        [
            path.join(config["app_enrich_dir"],
            f"{network}/output/{algo}/{param}/{enrichment_type}/{enrichment_subtype}/results/done")
            for network in config['ppi_networks']
            for algo, params in config['module_detection_params'].items()
            for param in params
            for enrichment_type, enrichment_subtypes in config['enrichment_types'].items()
            for enrichment_subtype in enrichment_subtypes
        ],

rule only_coexpression_networks:
    input:
        [
            path.join(config["app_enrich_dir"],
            f"{network}/output/{algo}/{param}/{enrichment_type}/{enrichment_subtype}/results/done")
            for network in config['coexpression_networks']
            for algo, params in config['module_detection_params'].items()
            for param in params
            for enrichment_type, enrichment_subtypes in config['enrichment_types'].items()
            for enrichment_subtype in enrichment_subtypes
        ],